APP_NAME=Trotro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trotro
DB_USERNAME=trotro
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=https://admin.example.com

# Sanctum bearer token lifetime in minutes (7 days).
SANCTUM_EXPIRATION=10080

# Force all generated URLs to HTTPS.
FORCE_HTTPS=true

# Set when running behind a reverse proxy/load balancer.
TRUSTED_PROXIES=

# First administrator created by `php artisan db:seed`.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=

# Customer phone approval for QR passes.
# driver: log (writes to the app log), hubtel, or arkesel.
SMS_DRIVER=log
SMS_SENDER=Trotro
# Shared secret for POST /api/sms/inbound and POST /api/ussd.
# Leave empty to disable the webhooks (they return 503).
SMS_WEBHOOK_SECRET=
SMS_USSD_SERVICE_CODE=*713#

HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_SMS_URL=https://smsc.hubtel.com/v1/messages/send

ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
