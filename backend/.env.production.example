# Copy to .env on the production server, fill in the blanks,
# then run: php artisan key:generate --force

APP_NAME=Trotro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test2.digitalsecuritymarket.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Create this dedicated user first (never deploy as root):
#   CREATE DATABASE trotro CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'trotro'@'localhost' IDENTIFIED BY '<strong-password>';
#   GRANT ALL PRIVILEGES ON trotro.* TO 'trotro'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trotro
DB_USERNAME=trotro
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=https://test2.digitalsecuritymarket.com
SANCTUM_EXPIRATION=10080
FORCE_HTTPS=true
# Comma-separated proxy IPs/CIDRs (Cloudflare, load balancer). This value is
# read before config loads, so also set it as a real server environment
# variable when deploying with `php artisan config:cache`.
TRUSTED_PROXIES=

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=

# SMS / USSD approval of pass charges.
# "log" writes to the application log; set "hubtel" or "arkesel" to send real SMS.
SMS_DRIVER=log
SMS_SENDER=Trotro
SMS_USSD_SERVICE_CODE=*713#
# Must match the secret configured in the gateway callback URL (?secret=... or X-Sms-Secret).
SMS_WEBHOOK_SECRET=

HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Trotro

ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Trotro
